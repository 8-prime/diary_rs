# Copy to .env for local development. .env is ignored by git -- keep real
# tokens out of the repository.

# Compile-time only: sqlx checks every query! macro against this database.
DATABASE_URL=sqlite://data/diary.db

# The admin password, in effect. Generate a fresh one per deployment:
#   openssl rand -base64 32
ADMIN_TOKEN=change-me

# Where the SQLite file lives.
DATA_DIR=data
# Where image blobs live. Defaults to $DATA_DIR/images when unset.
FILE_STORAGE=data/images

# A Secure cookie is never sent back over plain http, so logging in at
# http://localhost fails silently unless this is false in development.
COOKIE_SECURE=false

BIND_ADDR=127.0.0.1:3000
RUST_LOG=server=debug,domain=debug,tower_http=info
